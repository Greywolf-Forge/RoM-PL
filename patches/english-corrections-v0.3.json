  "corrections": [
    {
      "id": "naming-counter-tt2",
      "source_file": "INTERFACE.xml",
      "tag": "TXT_KEY_BUG_OPT_UNITNAMING__DEFAULT_HOVER",
      "occurrence": 0,
      "category": "MECHANICS_ERROR",
      "rationale": "The secondary counter is tt2, while tt1 has a range argument [x:y]. The example must use the token accepted by getTotal2 and swapCountCode. This changes the documented code, not the parser.",
      "evidence": [
        {
          "path": "Assets/Python/Contrib/UnitNameEventManager.py",
          "sha256": "4b9921d6195b379168d0ac83fd851fb7ca3a426ba3c7db2a4060d91102474b13",
          "selector": "getTotal2; swapCountCode",
          "excerpt": "getTotal2 finds \"^tt2[\"; swapCountCode(zsName, \"^tt2\", ziTT2)."
        }
      ],
      "compatibility": "Applies to this installed mod version; do not replace base BtS civic names globally. Text only; no game data changes.",
      "old": "tt1[f][x][COLOR_REVERT] - Count from x",
      "new": "tt2[f][x][COLOR_REVERT] - Count from x",
      "source_sha256": "73a124ab1bd4114bab7d7e1c4b4d83244d34ee7952dd3238e74be744b4aa86c2",
      "reviewer": "Astra /root; independent source and SHA review"
    },
    {
      "id": "trade-naming-option",
      "source_file": "INTERFACE.xml",
      "tag": "TXT_KEY_BUG_OPT_UNITNAMING__COMBAT_TRADE_HOVER",
      "occurrence": 0,
      "category": "FACTUAL_ERROR",
      "rationale": "The option and UI binding are Combat_TRADE. Combat_EXECUTIVES is a separate setting; copying its name into this tooltip describes the wrong control.",
      "evidence": [
        {
          "path": "Assets/Config/Unit Naming.xml",
          "sha256": "837731e20c9098d220d7d5b39b73b9307399ee63c4f6fd0d69adaf56952c2939",
          "selector": "option[@id=\"Combat_TRADE\"] and option[@id=\"Combat_EXECUTIVES\"]"
        },
        {
          "path": "Assets/Python/BUG/Tabs/BugUnitNameOptionsTab.py",
          "sha256": "e523082be6a9c8403c407b62a1cd36afcf116234a8da280af2399cb0388d1b22",
          "selector": "create",
          "excerpt": "self.addTextEdit(screen, columnL, columnR, \"UnitNaming__Combat_TRADE\")"
        }
      ],
      "compatibility": "Applies to this installed mod version; do not replace base BtS civic names globally. Text only; no game data changes.",
      "old": "'EXECUTIVES'",
      "new": "'TRADE'",
      "source_sha256": "73a124ab1bd4114bab7d7e1c4b4d83244d34ee7952dd3238e74be744b4aa86c2",
      "reviewer": "Astra /root; independent source and SHA review"
    },
    {
      "id": "hostile-takeover-name",
      "source_file": "EVENTS.xml",
      "tag": "TXT_KEY_EVENTTRIGGER_HOSTILE_TAKEOVER_DONE",
      "occurrence": 0,
      "category": "FACTUAL_ERROR",
      "rationale": "EVENTTRIGGER_HOSTILE_TAKEOVER_DONE uses this world-news text after the Hostile Takeover quest. Corporate Expansion is a different quest. Parameters and the rest of the completion message are preserved.",
      "evidence": [
        {
          "path": "Assets/XML/Events/CIV4EventTriggerInfos.xml",
          "sha256": "be139363f1e8db3c04582978e8879b4d34dc7a5b99059417f0527bba5ffdc1fb",
          "selector": "EVENTTRIGGER_HOSTILE_TAKEOVER_DONE/WorldNewsTexts",
          "excerpt": "TXT_KEY_EVENTTRIGGER_HOSTILE_TAKEOVER_DONE"
        },
        {
          "path": "Assets/Python/EntryPoints/CvRandomEventInterface.py",
          "sha256": "36983bfe00ac7e1f37ef48bc5d7a661c7e3f34bfd04685e9a1bf515eae8cf573",
          "selector": "canTriggerHostileTakeoverDone",
          "excerpt": "def canTriggerHostileTakeoverDone(argsList):\n\tkTriggeredData = argsList[0]\n\tplayer = gc.getPlayer(kTriggeredData.ePlayer)\n\ttrigger = gc.getEventTriggerInfo(kTriggeredData.eTrigger)\n\tkOrigTriggeredData = player.getEventOccured(trigger.getPrereqEvent(0))\n\n\tlistResources = getHostileTakeoverListResources(gc.getCorporationInfo(kOrigTriggeredData.eCorporation), player)\n\n\tif len(listResources) > 0:\n\t\treturn False\n\n\tkActualTriggeredDataObject = player.getEventTriggered(kTriggeredData.iId)\n\tkActualTriggeredDataObject.eCorporation = kOrigTriggeredData.eCorporation\n\tkActualTriggeredDataObject.eBuilding = kOrigTriggeredData.eBuilding\n\tkActualTriggeredDataObject.iCityId = kOrigTriggeredData.iCityId\n\tkActualTriggeredDataObject.iPlotX = kOrigTriggeredData.iPlotX\n\tkActualTriggeredDataObject.iPlotY = kOrigTriggeredData.iPlotY\n\n\treturn True"
        }
      ],
      "compatibility": "Applies to this installed mod version; do not replace base BtS civic names globally. Text only; no game data changes.",
      "old": "quest of Corporate Expansion",
      "new": "quest of Hostile Takeover",
      "source_sha256": "f32b7ba7f87379d404f0af93f60a90e5289d96ac2ed99a844788c00eb2acd800",
      "reviewer": "Astra /root; independent source and SHA review"
    },
    {
      "id": "guns-butter-civic",
      "source_file": "EVENTS.xml",
      "tag": "TXT_KEY_EVENT_GUNS_BUTTER_HELP_1",
      "occurrence": 0,
      "category": "MECHANICS_ERROR",
      "rationale": "canApplyGunsButterDone2 tests CIVIC_ARISTOCRACY. Its Description is TXT_KEY_CIVIC_ARISTOCRACY, whose English label is Nobility in this mod. Vassalage is the old BtS label and names the wrong mod civic.",
      "evidence": [
        {
          "path": "Assets/Python/EntryPoints/CvRandomEventInterface.py",
          "sha256": "36983bfe00ac7e1f37ef48bc5d7a661c7e3f34bfd04685e9a1bf515eae8cf573",
          "selector": "canApplyGunsButterDone2",
          "excerpt": "def canApplyGunsButterDone2(argsList):\n\tiEvent = argsList[0]\n\tkTriggeredData = argsList[1]\n\tplayer = gc.getPlayer(kTriggeredData.ePlayer)\n\n\tiCivic = gc.getInfoTypeForString(\"CIVIC_ARISTOCRACY\")\n\n\tif not player.isCivic(iCivic):\n\t\treturn False\n\n\treturn True"
        },
        {
          "path": "Assets/XML/GameInfo/CIV4CivicInfos.xml",
          "sha256": "250c34565270ec17f0c97cbfdeb1b51e0066ed5c6199c2e62c611f4b361eda67",
          "selector": "CIVIC_ARISTOCRACY/Description",
          "excerpt": "TXT_KEY_CIVIC_ARISTOCRACY"
        },
        {
          "path": "Assets/XML/Text/CIVICS.xml",
          "sha256": "1fb30b8b1d67b4cc4680840958e7a7740b1655bb8acc04b92b018ddfe6ef0b99",
          "selector": "TXT_KEY_CIVIC_ARISTOCRACY/English",
          "excerpt": "Nobility"
        }
      ],
      "compatibility": "Applies to this installed mod version; do not replace base BtS civic names globally. Text only; no game data changes.",
      "old": "[COLOR_HIGHLIGHT_TEXT]Vassalage[COLOR_REVERT]",
      "new": "[COLOR_HIGHLIGHT_TEXT]Nobility[COLOR_REVERT]",
      "source_sha256": "f32b7ba7f87379d404f0af93f60a90e5289d96ac2ed99a844788c00eb2acd800",
      "reviewer": "Astra /root; independent source and SHA review"
